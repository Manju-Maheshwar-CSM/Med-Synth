# ── MedSynth backend configuration ──────────────────────────────
# Copy this file to `.env` and adjust as needed.
# Everything works offline with the defaults below (mock mode).

# LLM provider mode: "mock" (offline, deterministic) or "api" (OpenAI-compatible)
LLM_MODE=mock

# OpenAI-compatible provider settings (only used when LLM_MODE=api)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# Approx max characters of source sent to the model before chunking kicks in
LLM_MAX_INPUT_CHARS=24000

# PubMed E-utilities (optional; improves rate limits / etiquette)
PUBMED_EMAIL=
PUBMED_API_KEY=

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
